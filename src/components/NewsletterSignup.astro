---
// The Kit (ConvertKit) "Engineering Leadership Weekly" signup card, shared by the
// homepage and /newsletter/. The default slot is the small print under the button.
interface Props {
  title?: string;
  subtitle?: string;
  buttonText?: string;
  inputId?: string;
}

const {
  title = "Engineering leadership weekly",
  subtitle = "Build humane, effective engineering organizations. Weekly email.",
  buttonText = "Sign me up!",
  inputId,
} = Astro.props;
---

<div class="newsletter-signup">
  {/* `defer`, not `async`: async can run mid-parse before the
      [data-sv-form] element exists. Without either, this blocks the
      parser (and the preload scanner) in the middle of the page. */}
  <script src="https://f.convertkit.com/ckjs/ck.5.js" is:inline defer></script>
  <form
    action="https://app.convertkit.com/forms/2891253/subscriptions"
    class="convertkit-form"
    method="post"
    data-sv-form="2891253"
    data-uid="3978146adc"
  >
    <div class="form-content">
      <div class="form-column">
        <h2>{title}</h2>
        <p class="form-subtitle">{subtitle}</p>
        <ul class="form-errors" data-element="errors"></ul>
        <div class="form-fields">
          <input
            id={inputId}
            class="form-input"
            name="email_address"
            aria-label="Email Address"
            placeholder="Email Address"
            required
            type="email"
          />
          <button type="submit" class="form-submit">
            {buttonText}
          </button>
        </div>
        <p class="form-disclaimer"><slot /></p>
      </div>
    </div>
  </form>
</div>

<style>
  .newsletter-signup {
    margin: 0 0 var(--space-l) 0;
  }

  .convertkit-form {
    background-color: #f9fafb;
    border-radius: var(--size-radius-default);
    box-shadow: 0 0 2px rgba(0, 0, 0, 0.15);
    max-width: 100%;
    overflow: hidden;
  }

  .form-content {
    width: 100%;
  }

  .form-column {
    padding: var(--space-l);
  }

  .form-column h2 {
    color: #4d4d4d;
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0 0 var(--space-xs) 0;
  }

  .form-subtitle {
    color: #595959;
    font-size: 0.95rem;
    line-height: 1.4;
    margin: 0 0 var(--space-m) 0;
  }

  .form-errors {
    background: #fde8e2;
    border: 1px solid #f2643b;
    border-radius: var(--size-radius-small);
    color: #ea4110;
    list-style: none;
    margin: 0 0 var(--space-m) 0;
    padding: var(--space-s);
    display: none;
  }

  .form-errors:not(:empty) {
    display: block;
  }

  /* ck.5.js renders its confirmation as .formkit-alert.formkit-alert-success,
     which nothing here styled — so a successful signup showed up as bare
     unstyled text that was easy to miss entirely. Mirror the .form-errors
     treatment in green. :global() is required because the element is injected
     at runtime and so never gets Astro's scope attribute. */
  .newsletter-signup :global(.formkit-alert-success) {
    background: #e6f4ea;
    border: 1px solid #34a853;
    border-radius: var(--size-radius-small);
    color: #1a7f37;
    font-size: 1.05rem;
    font-weight: 600;
    margin: 0;
    padding: var(--space-m);
    text-align: center;
  }

  .form-fields {
    margin-bottom: var(--space-m);
  }

  .form-input {
    width: 100%;
    background: #ffffff;
    font-size: 15px;
    padding: 12px;
    border: 1px solid #e3e3e3;
    border-radius: var(--size-radius-small);
    margin-bottom: var(--space-s);
    transition: border-color 0.3s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-brand-primary);
  }

  .form-input::placeholder {
    color: #8b8b8b;
    opacity: 0.5;
  }

  .form-submit {
    width: 100%;
    border: 0;
    border-radius: var(--size-radius-small);
    color: #ffffff;
    background-color: var(--color-brand-primary);
    cursor: pointer;
    font-size: 15px;
    font-weight: 500;
    padding: 12px 24px;
    transition: background-color 0.3s ease;
  }

  .form-submit:hover {
    background-color: var(--color-brand-hover);
  }

  .form-disclaimer {
    color: #595959;
    font-size: 13px;
    margin: 0;
  }

  .form-disclaimer a {
    color: var(--color-brand-primary);
    text-decoration: none;
  }

  .form-disclaimer a:hover {
    text-decoration: underline;
  }
</style>
