---
interface Props {
  href: string;
  mainText: string;
  subText: string;
  variant?: "primary" | "secondary";
  isExternal?: boolean;
}

const {
  href,
  mainText,
  subText,
  variant = "primary",
  isExternal = true,
} = Astro.props;

const linkProps = isExternal ? { target: "_blank", rel: "noreferrer" } : {};
---

<a href={href} {...linkProps} class:list={["cta-button", `cta-${variant}`]}>
  <span class="cta-disc">
    <slot name="icon" />
  </span>
  <span class="cta-body">
    <span class="cta-main">{mainText}</span>
    {subText && <span class="cta-sub">{subText}</span>}
  </span>
  <span class="cta-arrow">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="20" height="20" fill="currentColor" aria-hidden="true">
      <path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"></path>
    </svg>
  </span>
</a>

<style>
  .cta-button {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    box-sizing: border-box;
    border-radius: var(--size-radius-cta);
    padding: 20px 24px;
    width: 463px;
    max-width: 100%;
    margin: 0 30px 20px 0;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease,
      border-color 0.2s ease;
    transform: translateY(0);
    position: relative;
  }

  .cta-button:hover {
    transform: translateY(-3px);
  }

  /* Primary — warm orange gradient */
  .cta-primary {
    border: none;
    background: linear-gradient(135deg, #e88a3d, #e0651c);
    box-shadow: var(--shadow-cta);
  }

  .cta-primary:hover {
    background: linear-gradient(135deg, #f0852f, #d86519);
    box-shadow: var(--shadow-cta-hover);
  }

  /* Secondary — white card with blue outline that warms on hover */
  .cta-secondary {
    border: 2px solid var(--color-brand-primary);
    background: var(--color-neutral-white);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
  }

  .cta-secondary:hover {
    border-color: var(--color-brand-hover);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.1);
  }

  /* Icon disc */
  .cta-disc {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .cta-primary .cta-disc {
    color: #fff;
    background: rgba(255, 255, 255, 0.18);
  }

  .cta-secondary .cta-disc {
    color: var(--color-brand-primary);
    background: var(--color-accent-soft);
  }

  .cta-disc :global(svg) {
    width: 24px;
    height: 24px;
    fill: currentColor;
  }

  /* Text stack */
  .cta-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .cta-main {
    font-size: 19px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.1px;
  }

  .cta-sub {
    font-size: 13px;
    font-weight: 400;
    margin-top: 3px;
    letter-spacing: 0.2px;
  }

  .cta-primary .cta-main {
    color: #fff;
  }

  .cta-primary .cta-sub {
    color: rgba(255, 255, 255, 0.9);
  }

  .cta-secondary .cta-main {
    color: var(--color-brand-primary);
  }

  .cta-secondary:hover .cta-main {
    color: var(--color-brand-hover);
  }

  .cta-secondary .cta-sub {
    color: var(--color-neutral-gray-g);
  }

  /* Arrow */
  .cta-arrow {
    flex-shrink: 0;
    display: flex;
    transition: transform 0.2s ease;
  }

  .cta-button:hover .cta-arrow {
    transform: translateX(4px);
  }

  .cta-primary .cta-arrow {
    color: #fff;
  }

  .cta-secondary .cta-arrow {
    color: var(--color-brand-primary);
  }

  .cta-secondary:hover .cta-arrow {
    color: var(--color-brand-hover);
  }

  @media (max-width: 600px) {
    .cta-button {
      width: 100%;
      margin-right: 0;
    }
  }
</style>
